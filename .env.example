# =============================
# VN Legal Chatbot - Environment Variables
# =============================
# Copy this file to .env and fill in your own values
# Command: cp .env.example .env

# =============================
# APPLICATION SETTINGS
# =============================
PROJECT_NAME=VN Legal Intelligence Platform
API_V1_STR=/api/v1
ENVIRONMENT=development
# Options: development, staging, production

# =============================
# SECURITY (JWT)
# =============================
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 10080 minutes = 7 days

# =============================
# OpenAI / LLM Configuration
# =============================
# Get your key from: https://platform.openai.com/api-keys
LLM_PROVIDER=bedrock
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_REGION=ap-northeast-1
AWS_BEARER_TOKEN_BEDROCK=ABSK...your-bedrock-api-key
# Use 0.0 for production, 0.2 for staging/development

# =============================
# Embeddings Model
# =============================
# Multilingual embeddings for document chunking and retrieval
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# =============================
# Vector Database (Qdrant)
# =============================
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=law_data

# =============================
# Cache Database (Redis)
# =============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Leave empty if no password, or set if Redis requires authentication

# =============================
# MySQL Database
# =============================
# Connection details must match docker-compose.yml
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=legalbot_password
DB_NAME=law_chatbot_db

# =============================
# AWS Deployment
# =============================
# AWS_REGION=ap-southeast-1
# Secrets (e.g., OPENAI_API_KEY, DB_PASSWORD) are injected via AWS Secrets Manager in ECS task definition
# DB_HOST should point to the RDS MySQL endpoint

# Notes:
# - For Docker setup: use values from docker-compose.yml
# - For local MySQL: adjust to your MySQL credentials
# - Ensure DB_NAME database exists or use auto-migration

